# ---------- 前端构建产物与依赖 ----------
web/dist/
web/node_modules/
public/assets/
public/index.html

# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
.ruff_cache/
*.egg-info/

# ---------- 运行期数据（绝不入库）----------
db/
logs/
data/
*.db
*.db-journal
*.secret_key

# ---------- 环境变量与凭证 ----------
# deploy/.env 里含 ADMIN_PASSWORD 和 SECRET_KEY，泄露即等于交出管理员权限
deploy/.env
.env
.env.local
*.pem
*.key

# ---------- Docker 构建产物 ----------
# deploy/app 与 deploy/dist 是「发布包」的一部分，需要入库，
# 这样部署目录可以单独拷到服务器构建（不需要 node、不需要项目其余部分）。
deploy/__pycache__/

# ---------- TLS 证书 ----------
# 私钥不入库（上方已忽略 *.pem / *.key）。推荐在服务器上直接生成，10 秒且不传私钥：
#   ./deploy.sh cert <服务器IP或域名>
# 用正式证书就手动传过去：
#   scp fullchain.pem root@host:/path/deploy/certs/server.crt
#   scp privkey.pem   root@host:/path/deploy/certs/server.key
# 确实想把自签证书一并入库时，取消下面两行的注释：
# !deploy/certs/server.crt
# !deploy/certs/server.key
deploy/certs/*.crt
deploy/certs/*.key
deploy/certs/*.pem
deploy/certs/*.bak

# ---------- 编辑器与系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db

# WorkBuddy 工作目录（记忆/临时文件），不入库
.workbuddy/

# 打包产物
*.tar.gz
*.zip
# 离线部署包的中间目录与产物
deploy/.offline-stage/
ansible-ui-offline-*
