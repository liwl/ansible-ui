# ---------- 前端构建产物与依赖 ----------
web/dist/
web/node_modules/
public/assets/
public/index.html

# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
.ruff_cache/
*.egg-info/

# ---------- 运行期数据（绝不入库）----------
db/
logs/
data/
*.db
*.db-journal
*.secret_key

# ---------- 环境变量与凭证 ----------
# deploy/.env 里含 ADMIN_PASSWORD 和 SECRET_KEY，泄露即等于交出管理员权限
deploy/.env
.env
.env.local
*.pem
*.key

# ---------- Docker 构建产物 ----------
# deploy/app 与 deploy/dist 是「发布包」的一部分，需要入库，
# 这样部署目录可以单独拷到服务器构建（不需要 node、不需要项目其余部分）。
deploy/__pycache__/

# ---------- 编辑器与系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db

# WorkBuddy 工作目录（记忆/临时文件），不入库
.workbuddy/

# 打包产物
*.tar.gz
*.zip
