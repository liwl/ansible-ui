# ============ 服务端口 ============
# HOST_PORT：宿主机暴露端口；PORT：容器内 Flask 监听端口
HOST_PORT=5000
PORT=5000
HOST=0.0.0.0

# ============ HTTPS ============
# 走 HTTPS 只有一件事：让下面两个变量指向容器内的证书文件。
# 留空 = 明文 HTTP；填了 = Flask 自己用证书启动 TLS（不需要额外的反向代理镜像）。
#
# 最省事的做法：在 deploy 目录执行
#   ./deploy.sh cert 192.168.1.10          # 用服务器 IP
#   ./deploy.sh cert ansible.example.com   # 或用域名（可同时给多个，如 cert 域名 IP）
# 脚本会生成 certs/server.crt + certs/server.key，自动填好下面两行、
# 并把 HOST_PORT 改成 443，之后 ./deploy.sh up 就是 HTTPS 了。
#
# 真想用正式证书（Let's Encrypt 等）也行，把 fullchain.pem 存成 certs/server.crt、
# privkey.pem 存成 certs/server.key 覆盖掉自签文件即可，配置不用改。
#
# 注意：证书是运行时只读挂载（deploy/certs → /app/certs），换证书只需重启容器，
# 不需要重新构建镜像。
SSL_CERT_FILE=
SSL_KEY_FILE=
# 填好后长这样（容器内路径，不是宿主机路径）：
#   SSL_CERT_FILE=/app/certs/server.crt
#   SSL_KEY_FILE=/app/certs/server.key

# ============ 管理员账号（必改）============
# 首次启动会用这里的凭证初始化「主管理员」账号（写入 users 表）。
# 主管理员不可在界面上删除/降级，密码也以此处为唯一来源：
# 改这里的密码并重启后，首次登录会自动同步到数据库。
# 注意：主管理员凭证同时参与主机密码的加密密钥派生，改密码后已保存的主机密码将无法解密，需重新录入。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# ============ 多用户与权限 ============
# 登录后可在「用户管理」页创建更多账号，角色分两种：
#   admin  —— 全部权限
#   viewer —— 只读，可浏览主机/历史/文件（仅下载）与 Playbook，所有写操作由后端返回 403
# 角色以数据库为准，改角色/删账号对已登录会话立即生效（无需等令牌过期）。

# ============ 安全 ============
# 留空时会自动生成一个随机密钥并保存到 data/.secret_key（data 卷内），重启后继续复用，
# 单容器部署留空即可。多副本/多容器共享登录态时必须显式填同一个固定随机串。
# 生成方式：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# JWT 有效期（小时）
JWT_EXPIRATION_HOURS=5

# ============ 数据与日志（容器内路径，通过 volume 持久化）============
DB_PATH=db/ansible.db
UPLOAD_FOLDER=/tmp/ansible_uploads
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============ 调试 ============
# 生产环境保持 false
FLASK_DEBUG=false

# ============ Ansible ============
ANSIBLE_HOST_KEY_CHECKING=False
# 主机使用密钥认证时的默认私钥路径（主机单独配置优先；容器内路径，需通过 volume 挂载密钥）
SSH_PRIVATE_KEY=/root/.ssh/id_ed25519

# ============ 构建期包源（仅 docker build 时生效）============
# 国内服务器请用镜像源，否则 pip 装 ansible/cryptography 极易超时。
# 下面默认已填国内源；海外环境改回：
#   PIP_INDEX_URL=https://pypi.org/simple
#   DEBIAN_MIRROR=deb.debian.org
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
DEBIAN_MIRROR=mirrors.aliyun.com

# ============ 定时巡检 ============
# 是否启用后台定时巡检（自动 ping 所有主机并记录状态到看板）
PING_ENABLED=true
# 巡检间隔（秒），最小 30；默认 5 分钟
PING_INTERVAL=300
